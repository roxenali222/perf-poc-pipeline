# Copy this file to .env and fill in your values

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_KEY=your-azure-openai-key
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# Dynatrace
DYNATRACE_URL=https://your-tenant.live.dynatrace.com
DYNATRACE_TOKEN=your-dynatrace-api-token
DYNATRACE_ENTITY_SELECTOR=type(SERVICE),tag(environment:production)

# Target Application
TARGET_URL=https://your-application-url.com

# PageSpeed (optional - leave empty for free tier)
PAGESPEED_API_KEY=

# Regression
REGRESSION_THRESHOLD_PCT=15

# Teams
TEAMS_WEBHOOK_URL=https://your-company.webhook.office.com/...

# Jira (on-prem via VPN)
JIRA_URL=https://your-jira.company.com
JIRA_TOKEN=your-jira-token
JIRA_PROJECT_KEY=PERF
